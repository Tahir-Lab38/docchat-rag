# Required: create a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# ── Models ──────────────────────────────────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-20b
QUERY_REWRITE_MODEL=llama-3.1-8b-instant
QUERY_REWRITE_FALLBACK_MODEL=llama-3.3-70b-versatile
ANSWER_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── Server ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins ("*" allows all).
CORS_ORIGINS=*
LOG_LEVEL=INFO

# ── Storage ─────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50

# ── Embeddings ──────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking & retrieval ────────────────────────────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=8
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# ── Generation ──────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=768
MAX_CONVERSATIONS=500
